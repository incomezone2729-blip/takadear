# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ENCRYPTION_SECRET: 32+ character server secret for AES-256-GCM PII & wallet encryption.
ENCRYPTION_SECRET="CHANGE_ME_32_BYTE_ENCRYPTION_SECRET"

# API_SIGNING_SECRET: Server secret for HMAC-SHA256 transaction & receipt signing.
API_SIGNING_SECRET="CHANGE_ME_API_SIGNING_SECRET"

# TELEGRAM_BOT_TOKEN: Bot token from @BotFather for admin Telegram notifications.
TELEGRAM_BOT_TOKEN="MY_TELEGRAM_BOT_TOKEN"

# TELEGRAM_CHAT_ID: Numeric Telegram chat or user ID to receive admin notifications.
TELEGRAM_CHAT_ID="MY_TELEGRAM_CHAT_ID"

# VITE_API_BASE_URL: Optional full backend URL if frontend static build is hosted separately from Express backend.
# Leave empty when frontend and backend are served from the same Render Web Service.
# VITE_API_BASE_URL="https://your-backend.onrender.com"

# CORS_ORIGINS: Optional comma-separated list of allowed frontend origins for cross-origin API calls.
# CORS_ORIGINS="https://your-frontend.onrender.com"
