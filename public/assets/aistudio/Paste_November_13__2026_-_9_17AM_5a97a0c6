  const d = new Date();
  const months = ['জানু','ফেব','মার্চ','এপ্রিল','মে','জুন','জুলাই','আগস্ট','সেপ্ট','অক্টো','নভে','ডিসে'];
  let h = d.getHours(), m = String(d.getMinutes()).padStart(2,'0');
  const ap = h >= 12 ? 'PM' : 'AM';
  h = h % 12 || 12;
  return `${bn(d.getDate())} ${months[d.getMonth()]}, ${bn(h)}:${bn(m)} ${ap}`;
}

function toast(msg, type=''){
  const t = $('toast');
  t.textContent = msg;
  t.className = 'toast show ' + type;
  clearTimeout(t._tid);
  t._tid = setTimeout(()=>{ t.className = 'toast ' + type; }, 2600);
}

function openModal(html){
  $('modalBox').innerHTML = html;
  $('modalBg').classList.add('show');
}
function closeModal(){ $('modalBg').classList.remove('show'); }
$('modalBg').addEventListener('click', e => { if(e.target.id === 'modalBg') closeModal(); });

function confetti(){
  const colors = ['#6c5ce7','#00d68f','#f7b731','#ff5c7a','#3aa8ff','#a29bfe'];
  for(let i=0;i<40;i++){
    const el = document.createElement('div');
    el.className = 'confetti';
    el.style.left = Math.random()*100 + '%';
    el.style.top = '-20px';
    el.style.background = colors[Math.floor(Math.random()*colors.length)];
    el.style.animation = `fall ${1.6 + Math.random()*1.4}s linear forwards`;
    el.style.animationDelay = (Math.random()*0.4) + 's';
    if(Math.random() > .5) el.style.borderRadius = '50%';
    $('phone').appendChild(el);
    setTimeout(()=>el.remove(), 3600);
  }
}

/* ---------------------------------------------------------------
   ৪. Firebase অথেনটিকেশন (ইমেইল/পাসওয়ার্ড)
   --------------------------------------------------------------- */
function setAuthMode(mode){
  authMode = mode;
  const isSignup = mode === 'signup';
  $('authTitle').textContent   = isSignup ? 'স্বাগতম!' : 'আবার স্বাগতম!';
  $('authSub').textContent     = isSignup ? 'ইমেইল ও পাসওয়ার্ড দিয়ে অ্যাকাউন্ট তৈরি করুন' : 'আপনার অ্যাকাউন্টে লগইন করুন';
  $('nameField').style.display = isSignup ? 'block' : 'none';
  $('refField').style.display  = isSignup ? 'block' : 'none';
  $('authBtn').textContent     = isSignup ? 'অ্যাকাউন্ট তৈরি করুন' : 'লগইন করুন';
  $('switchText').textContent  = isSignup ? 'আগে থেকেই অ্যাকাউন্ট আছে?' : 'নতুন ব্যবহারকারী?';
  $('switchBtn').textContent   = isSignup ? 'লগইন' : 'সাইনআপ';
}
$('switchBtn').addEventListener('click', () => setAuthMode(authMode === 'signup' ? 'login' : 'signup'));

$('authBtn').addEventListener('click', async () => {
  const email = $('inpEmail').value.trim();
  const pass  = $('inpPass').value;
  const name  = $('inpName').value.trim();
  const ref   = $('inpRef').value.trim().toUpperCase();

  if(!email || !pass){ toast('ইমেইল ও পাসওয়ার্ড দিন', 'err'); return; }
  if(pass.length < 6){ toast('পাসওয়ার্ড কমপক্ষে ৬ অক্ষর', 'err'); return; }
  if(authMode === 'signup' && name.length < 2){ toast('নাম লিখুন', 'err'); return; }

  $('authBtn').disabled = true;
  $('authBtn').textContent = 'অপেক্ষা করুন...';

  try {
    let cred;
    if(authMode === 'signup'){
      cred = await auth.createUserWithEmailAndPassword(email, pass);
      const uid = cred.user.uid;
      const refCode = 'TK' + email.slice(0,3).toUpperCase() + uid.slice(-4).toUpperCase();

      // নতুন ইউজার ডেটা
      const newData = {
        name, email, refCode, referredBy: ref || null,
        balance: SIGNUP_BONUS,
        totalEarned: SIGNUP_BONUS,
        referrals: 0, refEarned: 0,
        streak: { last: null, count: 0 },
        daily: { date: todayKey(), spins: 0, ads: 0, tasks: {}, todayEarn: 0 },
        tx: [{ id: uid(), type:'in', amount: SIGNUP_BONUS, title:'সাইনআপ বোনাস', icon:'🎁', date: now(), ts: Date.now() }],
        withdrawals: [],
        spins: [],
        createdAt: Date.now()
      };

      if(ref){
        // রেফারারকে বোনাস
        const snap = await db.ref('users').orderByChild('refCode').equalTo(ref).once('value');
        snap.forEach(child => {
          const rUid = child.key;
          const r = child.val();
          db.ref('users/' + rUid).update({
            balance: (r.balance || 0) + REFERRAL_BONUS,
            totalEarned: (r.totalEarned || 0) + REFERRAL_BONUS,
            referrals: (r.referrals || 0) + 1,
            refEarned: (r.refEarned || 0) + REFERRAL_BONUS
          });
          db.ref('users/' + rUid + '/tx').push({
            id: uid(), type:'in', amount: REFERRAL_BONUS,
            title: 'রেফারেল বোনাস (' + email + ')', icon:'🤝', date: now(), ts: Date.now()
          });
        });
        newData.balance += REFERRAL_BONUS;
        newData.totalEarned += REFERRAL_BONUS;
        newData.tx.push({ id: uid(), type:'in', amount: REFERRAL_BONUS, title:'রেফারেল বোনাস', icon:'🤝', date: now(), ts: Date.now() });
      }

      await db.ref('users/' + uid).set(newData);
      toast('অ্যাকাউন্ট তৈরি সফল!', 'ok');
      confetti();
      openModal(`<span class="m-ic">🎉</span><h3>স্বাগতম!</h3><p>আপনি পেয়েছেন <b style="color:var(--green)">৳${SIGNUP_BONUS}</b> সাইনআপ বোনাস।</p><div class="m-actions"><button class="btn" onclick="closeModal()">শুরু করুন</button></div>`);
    } else {
      cred = await auth.signInWithEmailAndPassword(email, pass);
      toast('লগইন সফল!', 'ok');
    }
    // onAuthStateChanged হ্যান্ডেল করবে
  } catch(e){
    let msg = 'সমস্যা হয়েছে';
    if(e.code === 'auth/email-already-in-use') msg = 'এই ইমেইল ইতিমধ্যে নিবন্ধিত';
    else if(e.code === 'auth/invalid-email') msg = 'ইমেইল সঠিক নয়';
    else if(e.code === 'auth/weak-password') msg = 'পাসওয়ার্ড দুর্বল';
    else if(e.code === 'auth/user-not-found' || e.code === 'auth/wrong-password') msg = 'ইমেইল বা পাসওয়ার্ড ভুল';
    toast(msg, 'err');
  } finally {
    $('authBtn').disabled = false;
    $('authBtn').textContent = authMode === 'signup' ? 'অ্যাকাউন্ট তৈরি করুন' : 'লগইন করুন';
  }
});

/* ---------------------------------------------------------------
   ৫. Auth স্টেট লিসেনার
   --------------------------------------------------------------- */
auth.onAuthStateChanged(async user => {
  if(user){
    currentUser = user;
    const snap = await db.ref('users/' + user.uid).once('value');
    if(!snap.exists()){
      // ডেটা না থাকলে তৈরি
      await db.ref('users/' + user.uid).set({
        name: user.email.split('@')[0],
        email: user.email,
        refCode: 'TK' + user.uid.slice(-6).toUpperCase(),
        balance: 0, totalEarned: 0, referrals: 0, refEarned: 0,
        streak: { last: null, count: 0 },
        daily: { date: todayKey(), spins: 0, ads: 0, tasks: {}, todayEarn: 0 },
        tx: [], withdrawals: [], spins: [], createdAt: Date.now()
      });
    }
    userData = (await db.ref('users/' + user.uid).once('value')).val();
    isAdmin = user.email === ADMIN_EMAIL || user.email.startsWith('admin@');
    showScreen('mainScreen');
    applyTheme();
    renderAll();
    goPage('home');
    if(isAdmin) toast('অ্যাডমিন হিসেবে লগইন করেছেন', 'gold');
  } else {
    currentUser = null; userData = null; isAdmin = false;
    setAuthMode('signup');
    showScreen('authScreen');
  }
});

/* ---------------------------------------------------------------
   ৬. স্ক্রিন নেভিগেশন
   --------------------------------------------------------------- */
function showScreen(id){
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  $(id).classList.add('active');
}
function goPage(page){
  currentPage = page;
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  const el = $('page-' + page);
  if(el) el.classList.add('active');
  document.querySelectorAll('.nav-item').forEach(n => n.classList.toggle('active', n.dataset.page === page));
  $('pages').scrollTop = 0;
  renderPage(page);
}
document.querySelectorAll('.nav-item').forEach(btn => {
  btn.addEventListener('click', () => goPage(btn.dataset.page));
});
document.querySelectorAll('.quick[data-go]').forEach(q => {
  q.addEventListener('click', () => goPage(q.dataset.go));
});

/* ---------------------------------------------------------------
   ৭. রেন্ডার
   --------------------------------------------------------------- */
function renderAll(){
  renderHeader();
  renderHome();
  renderTasks();
  renderSpin();
  renderWallet();
  renderProfile();
}
function renderPage(p){
  if(p === 'home')    renderHome();
  if(p === 'tasks')   renderTasks();
  if(p === 'spin')    renderSpin();
  if(p === 'wallet')  renderWallet();
  if(p === 'profile') renderProfile();
}
function renderHeader(){
  if(!userData) return;
  const initial = userData.name ? userData.name.charAt(0) : 'ব';
  $('hdrAvatar').textContent = initial;
  $('hdrName').textContent = userData.name;
  const lvl = Math.floor((userData.totalEarned||0) / 200) + 1;
  $('hdrSub').textContent = `লেভেল ${bn(lvl)} • ${bn(userData.referrals||0)} রেফারেল`;
  $('hdrBalance').textContent = '৳' + fmt(userData.balance||0);
}
function renderHome(){
  if(!userData) return;
  $('homeBalance').textContent = fmt(userData.balance||0);
  $('homeEarned').textContent  = '৳' + bn(Math.round(userData.totalEarned||0));
  $('homeRefs').textContent    = bn(userData.referrals||0) + ' জন';
  $('homeStreak').textContent  = bn(userData.streak?.count||0) + ' দিন';

  // চেক-ইন
  const daysEl = $('checkinDays'); daysEl.innerHTML = '';
  const today = todayKey();
  const checkedToday = userData.streak?.last === today;
  for(let i=0;i<7;i++){
    const d = document.createElement('div');
    d.className = 'cday';
    const cnt = userData.streak?.count || 0;
    const done = checkedToday && i < ((cnt - 1) % 7) + 1;
    if(done) d.classList.add('done');
    if(!checkedToday && i === (cnt % 7)) d.classList.add('today');
    d.innerHTML = `<b>${bn(i+1)}</b><span>৳${bn(STREAK_BONUS[i])}</span>`;
    daysEl.appendChild(d);
  }
  const btn = $('checkinBtn');
  if(checkedToday){ btn.disabled = true; btn.textContent = '✓ সম্পন্ন'; $('checkinStatus').textContent = 'সম্পন্ন'; }
  else { btn.disabled = false; btn.textContent = 'আজকের বোনাস নিন'; $('checkinStatus').textContent = 'আজ বাকি'; }

  const dly = userData.daily || {};
  $('statAds').textContent   = bn(dly.ads||0) + '/' + bn(AD_LIMIT);
  $('statSpins').textContent = bn(SPIN_LIMIT - (dly.spins||0)) + '/' + bn(SPIN_LIMIT);
  $('statTasks').textContent = bn(Object.values(dly.tasks||{}).reduce((a,b)=>a+b,0));
  $('statToday').textContent = '৳' + bn(Math.round(dly.todayEarn||0));

  const recent = (userData.tx||[]).slice(0,4);
  const box = $('homeTx');
  box.innerHTML = recent.length ? recent.map(txHTML).join('') : '<div class="empty"><span class="ic">📭</span>কোনো লেনদেন নেই</div>';
}
function txHTML(t){
  const sign = t.type === 'in' ? '+' : '-';
  return `<div class="tx"><div class="ic">${t.icon||'💰'}</div><div class="info"><h5>${t.title}</h5><span>${t.date}</span></div><div class="amt ${t.type}">${sign}৳${fmt(t.amount)}</div></div>`;
}

/* ---------------------------------------------------------------
   ৮. চেক-ইন
   --------------------------------------------------------------- */
$('checkinBtn').addEventListener('click', async () => {
  if(!currentUser) return;
  const today = todayKey();
  if(userData.streak?.last === today){ toast('আজ চেক-ইন করেছেন', 'err'); return; }

  const y = new Date(); y.setDate(y.getDate()-1);
  const yKey = `${y.getFullYear()}-${String(y.getMonth()+1).padStart(2,'0')}-${String(y.getDate()).padStart(2,'0')}`;
  let cnt = (userData.streak?.last === yKey) ? (userData.streak.count+1) : 1;

  const idx = (cnt-1)%7;
  const reward = STREAK_BONUS[idx];

  await db.ref('users/' + currentUser.uid).update({
    'streak/last': today,
    'streak/count': cnt,
    balance: (userData.balance||0) + reward,
    totalEarned: (userData.totalEarned||0) + reward,
    'daily/todayEarn': ((userData.daily?.todayEarn)||0) + reward
  });
  await db.ref('users/' + currentUser.uid + '/tx').push({
    id: uid(), type:'in', amount: reward, title:`চেক-ইন (দিন ${cnt})`, icon:'📅', date: now(), ts: Date.now()
  });

  userData = (await db.ref('users/' + currentUser.uid).once('value')).val();
  renderAll();
  confetti();
  openModal(`<span class="m-ic">🎁</span><h3>চেক-ইন সফল!</h3><p>পেয়েছেন <b style="color:var(--green)">৳${bn(reward)}</b></p><div class="m-actions"><button class="btn" onclick="closeModal()">ঠিক আছে</button></div>`);
});

/* ---------------------------------------------------------------
   ৯. টাস্ক
   --------------------------------------------------------------- */
function renderTasks(){
  const list = $('taskList');
  if(!userData) return;
  list.innerHTML = TASKS.map(task => {
    const done = (userData.daily?.tasks||{})[task.id] || 0;
    const left = Math.max(0, task.limit - done);
    const finished = left === 0;
    return `<div class="task"><div class="ic">${task.icon}</div><div class="info"><h4>${task.title}</h4><p>${task.desc} • বাকি ${bn(left)}/${bn(task.limit)}</p></div><div style="display:flex;flex-direction:column;align-items:flex-end;gap:6px"><div class="rw">+৳${bn(task.reward)}</div><button class="task-btn" ${finished?'disabled':''} data-task="${task.id}">${finished?'শেষ':'শুরু'}</button></div></div>`;
  }).join('');
  list.querySelectorAll('.task-btn[data-task]').forEach(btn => {
    btn.addEventListener('click', () => startTask(btn.dataset.task));
  });
}
function startTask(id){
  const task = TASKS.find(t => t.id === id);
  if(!task) return;
  const done = (userData.daily?.tasks||{})[id] || 0;
  if(done >= task.limit){ toast('লিমিট শেষ', 'err'); return; }

  if(task.id === 'quiz')   return runQuiz(task);
  if(task.id === 'survey') return runSurvey(task);
  if(task.id === 'invite') return runInvite(task);
  runTimerTask(task);
}
function runTimerTask(task){
  let left = task.timer;
  openModal(`<span class="m-ic">${task.icon}</span><h3>${task.title}</h3><p>${task.timer} সেকেন্ড অপেক্ষা করুন...</p><div class="countdown" id="cd">${bn(left)}</div><div class="progress"><i id="cdBar"></i></div>`);
  const bar = $('cdBar'); const el = $('cd');
  setTimeout(()=>{ if(bar) bar.style.width = '100%'; }, 50);
  const iv = setInterval(() => {
    left--;
    if(el) el.textContent = bn(Math.max(0,left));
    if(left <= 0){ clearInterval(iv); completeTask(task); }
  }, 1000);
  const chk = setInterval(() => {
    if(!$('modalBg').classList.contains('show')){ clearInterval(iv); clearInterval(chk); }
  }, 400);
}
async function completeTask(task){
  const uid = currentUser.uid;
  const done = ((userData.daily?.tasks||{})[task.id] || 0) + 1;
  await db.ref('users/' + uid).update({
    [`daily/tasks/${task.id}`]: done,
    'daily/ads': task.id === 'ad' ? ((userData.daily?.ads||0) + 1) : (userData.daily?.ads||0),
    balance: (userData.balance||0) + task.reward,
    totalEarned: (userData.totalEarned||0) + task.reward,
    'daily/todayEarn': ((userData.daily?.todayEarn)||0) + task.reward
  });
  await db.ref('users/' + uid + '/tx').push({
    id: uid(), type:'in', amount: task.reward, title: task.title, icon: task.icon, date: now(), ts: Date.now()
  });
  userData = (await db.ref('users/' + uid).once('value')).val();
  renderAll();
  openModal(`<span class="m-ic">✅</span><h3>টাস্ক সম্পন্ন!</h3><p>পেয়েছেন <b style="color:var(--green)">৳${bn(task.reward)}</b></p><div class="m-actions"><button class="btn green" onclick="closeModal()">দুর্দান্ত</button></div>`);
}
function runQuiz(task){
  const q = QUIZ_DATA[Math.floor(Math.random()*QUIZ_DATA.length)];
  openModal(`<span class="m-ic">🧠</span><h3>কুইজ</h3><p style="margin-bottom:14px">${q.q}</p><div id="quizOpts">${q.opts.map((o,i)=>`<button class="opt" data-i="${i}">${o}</button>`).join('')}</div>`);
  $('quizOpts').querySelectorAll('.opt').forEach(b => {
    b.addEventListener('click', () => {
      if(Number(b.dataset.i) === q.ans) completeTask(task);
      else openModal(`<span class="m-ic">😔</span><h3>ভুল</h3><p>সঠিক: <b>${q.opts[q.ans]}</b></p><div class="m-actions"><button class="btn" onclick="closeModal()">ঠিক আছে</button></div>`);
    });
  });
}
function runSurvey(task){
  let i = 0;
  function ask(){
    if(i >= SURVEY_DATA.length){ completeTask(task); return; }
    const q = SURVEY_DATA[i];
    openModal(`<span class="m-ic">📋</span><h3>প্রশ্ন ${bn(i+1)}/${bn(SURVEY_DATA.length)}</h3><p style="margin-bottom:14px">${q.q}</p><div id="svOpts">${q.opts.map((o,j)=>`<button class="opt" data-i="${j}">${o}</button>`).join('')}</div>`);
    $('svOpts').querySelectorAll('.opt').forEach(b => {
      b.addEventListener('click', () => { i++; ask(); });
    });
  }
  ask();
}
function runInvite(task){
  const link = `${location.origin}${location.pathname}?ref=${userData.refCode}`;
  openModal(`<span class="m-ic">🤝</span><h3>বন্ধুকে আমন্ত্রণ</h3><p>আপনার কোড শেয়ার করুন। বন্ধু সাইনআপ করলে আপনি ২০৳ পাবেন।</p><div class="ref-box" style="margin:0 0 16px"><code style="font-size:15px">${userData.refCode}</code></div><div class="m-actions"><button class="btn ghost" onclick="closeModal()">বন্ধ</button><button class="btn" id="shareNow">শেয়ার</button></div>`);
  $('shareNow').addEventListener('click', async () => {
    try {
      if(navigator.share) await navigator.share({ title:'টাকাডিয়ার', text:`আমার রেফারেল কোড: ${userData.refCode}`, url: link });
      else { await navigator.clipboard.writeText(link); toast('লিংক কপি!', 'ok'); }
      closeModal();
    } catch(e){}
  });
}

/* ---------------------------------------------------------------
   ১০. স্পিন
   --------------------------------------------------------------- */
function buildWheel(){
  const wheel = $('wheel');
  const stops = WHEEL.map((w,i) => `${w.c} ${i*SEG}deg ${(i+1)*SEG}deg`).join(', ');
  wheel.style.background = `conic-gradient(from 0deg, ${stops})`;
  wheel.querySelectorAll('.wheel-label').forEach(l => l.remove());
  WHEEL.forEach((w,i) => {
    const lbl = document.createElement('div');
    lbl.className = 'wheel-label';
    lbl.textContent = (w.v < 1 ? w.v : bn(w.v)) + '৳';
    const angle = i*SEG + SEG/2;
    lbl.style.transform = `rotate(${angle}deg) translateY(-94px) rotate(-${angle}deg)`;
    wheel.appendChild(lbl);
  });
}
function renderSpin(){
  if(!userData) return;
  $('spinsLeft').textContent = bn(Math.max(0, SPIN_LIMIT - (userData.daily?.spins||0)));
  const hist = (userData.spins||[]).slice(0,8);
  $('spinHistory').innerHTML = hist.length ? hist.map(s => `<div class="tx"><div class="ic">🎡</div><div class="info"><h5>স্পিন</h5><span>${s.date}</span></div><div class="amt in">+৳${fmt(s.amount)}</div></div>`).join('') : '<div class="empty"><span class="ic">🎯</span>এখনো স্পিন করেননি</div>';
  const btn = $('spinBtn');
  const left = SPIN_LIMIT - (userData.daily?.spins||0);
  if(left <= 0){ btn.disabled = true; btn.textContent = 'আজকের স্পিন শেষ'; }
  else { btn.disabled = false; btn.textContent = `ফ্রি স্পিন (${bn(left)} বাকি)`; }
}
$('spinBtn').addEventListener('click', async () => {
  if(isSpinning || !userData) return;
  if((userData.daily?.spins||0) >= SPIN_LIMIT){ toast('লিমিট শেষ', 'err'); return; }

  isSpinning = true;
  const btn = $('spinBtn'); btn.disabled = true;

  const idx = Math.floor(Math.random()*WHEEL.length);
  const prize = WHEEL[idx].v;
  const targetAngle = (360 - (idx*SEG + SEG/2)) % 360;
  const curMod = ((totalRotation % 360) + 360) % 360;
  let delta = targetAngle - curMod;
  if(delta < 0) delta += 360;
  totalRotation += 360*6 + delta;
  $('wheel').style.transform = `rotate(${totalRotation}deg)`;

  setTimeout(async () => {
    const uid = currentUser.uid;
    await db.ref('users/' + uid).update({
      'daily/spins': (userData.daily?.spins||0) + 1,
      balance: (userData.balance||0) + prize,
      totalEarned: (userData.totalEarned||0) + prize,
      'daily/todayEarn': ((userData.daily?.todayEarn)||0) + prize
    });
    await db.ref('users/' + uid + '/spins').push({ amount: prize, date: now(), ts: Date.now() });
    await db.ref('users/' + uid + '/tx').push({
      id: uid(), type:'in', amount: prize, title:'লাকি স্পিন', icon:'🎡', date: now(), ts: Date.now()
    });
    userData = (await db.ref('users/' + uid).once('value')).val();
    isSpinning = false;
    renderAll();
    if(prize >= 10) confetti();
    openModal(`<span class="m-ic">${prize>=10?'🎉':'🎡'}</span><h3>${prize>=10?'দুর্দান্ত!':'জিতেছেন'}</h3><p style="font-size:15px">পেয়েছেন <b style="color:var(--green);font-size:24px">৳${fmt(prize)}</b></p><div class="m-actions"><button class="btn gold" onclick="closeModal()">দারুণ</button></div>`);
  }, 4700);
});

/* ---------------------------------------------------------------
   ১১. ওয়ালেট
   --------------------------------------------------------------- */
function renderWallet(){
  if(!userData) return;
  $('walletBalance').textContent = fmt(userData.balance||0);
  const w = userData.withdrawals||[];
  $('withdrawHistory').innerHTML = w.length ? w.map(x => `<div class="tx"><div class="ic">${x.method==='bKash'?'🟣':x.method==='Nagad'?'🟠':'🔴'}</div><div class="info"><h5>${x.method} • ${x.number}</h5><span>${x.date}</span></div><div class="amt out">৳${fmt(x.amount)}<span class="badge">${x.status}</span></div></div>`).join('') : '<div class="empty"><span class="ic">🏦</span>এখনো উত্তোলন করেননি</div>';
}
document.querySelectorAll('.method').forEach(m => {
  m.addEventListener('click', () => {
    document.querySelectorAll('.method').forEach(x => x.classList.remove('active'));
    m.classList.add('active'); selectedMethod = m.dataset.m;
  });
});
$('withdrawBtn').addEventListener('click', async () => {
  if(!userData) return;
  const num = $('inpWithdrawNum').value.trim();
  const amt = parseFloat($('inpWithdrawAmt').value);
  if(!/^01[3-9]\d{8}$/.test(num)){ toast('সঠিক নম্বর দিন', 'err'); return; }
  if(!amt || amt < MIN_WITHDRAW){ toast(`সর্বনিম্ন ৳${MIN_WITHDRAW}`, 'err'); return; }
  if(amt > (userData.balance||0)){ toast('ব্যালেন্স কম', 'err'); return; }

  openModal(`<span class="m-ic">🏦</span><h3>নিশ্চিত?</h3><p><b>৳${fmt(amt)}</b> উত্তোলন<br>${selectedMethod} • ${num}</p><div class="m-actions"><button class="btn ghost" onclick="closeModal()">বাতিল</button><button class="btn green" id="confirmWd">নিশ্চিত</button></div>`);
  $('confirmWd').addEventListener('click', async () => {
    const uid = currentUser.uid;
    await db.ref('users/' + uid).update({ balance: (userData.balance||0) - amt });
    await db.ref('users/' + uid + '/withdrawals').push({
      id: uid(), method: selectedMethod, number: num, amount: amt, date: now(), status: 'প্রসেসিং', ts: Date.now()
    });
    await db.ref('users/' + uid + '/tx').push({
      id: uid(), type:'out', amount: amt, title: `${selectedMethod} উত্তোলন`, icon:'🏦', date: now(), ts: Date.now()
    });
    userData = (await db.ref('users/' + uid).once('value')).val();
    closeModal(); renderAll(); confetti();
    toast('উত্তোলনের অনুরোধ পাঠানো হয়েছে', 'ok');
  });
});

/* ---------------------------------------------------------------
   ১২. প্রোফাইল
   --------------------------------------------------------------- */
function renderProfile(){
  if(!userData) return;
  $('profAvatar').textContent = (userData.name||'ব').charAt(0);
  $('profName').textContent   = userData.name;
  $('profEmail').textContent  = userData.email;
  $('myRefCode').textContent  = userData.refCode;
  $('refCount').textContent   = bn(userData.referrals||0);
  $('refEarned').textContent  = '৳' + bn(Math.round(userData.refEarned||0));
}
$('copyRefBtn').addEventListener('click', async () => {
  try { await navigator.clipboard.writeText(userData.refCode); toast('কপি!', 'ok'); }
  catch(e){ toast('কপি ব্যর্থ', 'err'); }
});
$('themeToggle').addEventListener('click', () => {
  const t = document.body.dataset.theme === 'dark' ? 'light' : 'dark';
  document.body.dataset.theme = t;
  db.ref('users/' + currentUser.uid).update({ 'settings/theme': t });
  toast(t === 'dark' ? 'ডার্ক মোড' : 'লাইট মোড');
});
$('logoutBtn').addEventListener('click', () => {
  openModal(`<span class="m-ic">🚪</span><h3>লগআউট?</h3><div class="m-actions"><button class="btn ghost" onclick="closeModal()">না</button><button class="btn red" id="confirmLogout">লগআউট</button></div>`);
  $('confirmLogout').addEventListener('click', async () => {
    await auth.signOut(); closeModal(); toast('লগআউট হয়েছে');
  });
});

/* ---------------------------------------------------------------
   ১৩. অ্যাডমিন প্যানেল
   --------------------------------------------------------------- */
$('adminBtn').addEventListener('click', () => {
  if(!isAdmin){ toast('আপনি অ্যাডমিন নন', 'err'); return; }
  showScreen('adminScreen');
  loadAdminData();
});
$('adminExit').addEventListener('click', () => { showScreen('mainScreen'); goPage('profile'); });

let adminTab = 'overview';
document.querySelectorAll('.admin-tab').forEach(t => {
  t.addEventListener('click', () => {
    document.querySelectorAll('.admin-tab').forEach(x => x.classList.remove('active'));
    t.classList.add('active'); adminTab = t.dataset.atab;
    document.querySelectorAll('#adminPages .page').forEach(p => p.classList.remove('active'));
    $('atab-' + adminTab).classList.add('active');
    loadAdminData();
  });
});

async function loadAdminData(){
  try {
    const snap = await db.ref('users').once('value');
    const users = [];
    snap.forEach(child => users.push({ id: child.key, ...child.val() }));

    const totalUsers = users.length;
    const totalBal   = users.reduce((a,u)=>a + (u.balance||0), 0);
    const totalEarn  = users.reduce((a,u)=>a + (u.totalEarned||0), 0);
    let totalWd = 0; let allTx = [];
    users.forEach(u => {
      (u.withdrawals||[]).forEach(w => { if(w.status !== 'বাতিল') totalWd += (w.amount||0); });
      (u.tx||[]).forEach(t => allTx.push({ ...t, userName: u.name, userEmail: u.email }));
    });
    allTx.sort((a,b)=> (b.ts||0)-(a.ts||0));

    $('admTotalUsers').textContent    = bn(totalUsers);
    $('admTotalBalance').textContent  = '৳' + bn(Math.round(totalBal));
    $('admTotalEarned').textContent   = '৳' + bn(Math.round(totalEarn));
    $('admTotalWithdraw').textContent = '৳' + bn(Math.round(totalWd));
    $('adminSub').textContent = `মোট ${bn(totalUsers)} ব্যবহারকারী • Firebase`;

    // সাম্প্রতিক লেনদেন
    $('admRecentTx').innerHTML = allTx.slice(0,6).map(t => `
      <div class="tx">
        <div class="ic">${t.icon||'💰'}</div>
        <div class="info"><h5>${t.userName||'—'} — ${t.title||'—'}</h5><span>${t.date||''}</span></div>
        <div class="amt ${t.type==='in'?'in':'out'}">${t.type==='in'?'+':'-'}৳${fmt(t.amount||0)}</div>
      </div>`).join('') || '<div class="empty"><span class="ic">📭</span>কোনো লেনদেন নেই</div>';

    // ব্যবহারকারী তালিকা
    const q = ($('adminUserSearch').value||'').toLowerCase();
    const filtered = users.filter(u => (u.name||'').toLowerCase().includes(q) || (u.email||'').toLowerCase().includes(q));
    $('adminUserList').innerHTML = filtered.length ? filtered.map(u => `
      <div class="admin-user-row">
        <div class="av">${(u.name||'?').charAt(0)}</div>
        <div class="info"><h5>${u.name||'—'}</h5><span>${u.email||'—'}</span></div>
        <div class="bal">৳${fmt(u.balance||0)}</div>
        <div class="admin-actions">
          <button class="add" onclick="adminCredit('${u.id}', 100)">+১০০</button>
          <button class="ded" onclick="adminDebit('${u.id}', 50)">-৫০</button>
          <button class="det" onclick="adminView('${u.id}')">বিস্তারিত</button>
        </div>
      </div>`).join('') : '<div class="empty"><span class="ic">🔍</span>কোনো ব্যবহারকারী পাওয়া যায়নি</div>';

    // লেনদেন তালিকা
    $('adminTxList').innerHTML = allTx.slice(0,20).map(t => `
      <div class="tx">
        <div class="ic">${t.icon||'💰'}</div>
        <div class="info"><h5>${t.userName||'—'} — ${t.title||'—'}</h5><span>${t.userEmail||''} • ${t.date||''}</span></div>
        <div class="amt ${t.type==='in'?'in':'out'}">${t.type==='in'?'+':'-'}৳${fmt(t.amount||0)}</div>
      </div>`).join('') || '<div class="empty"><span class="ic">💰</span>কোনো লেনদেন নেই</div>';

    // উত্তোলন তালিকা
    let wds = [];
    users.forEach(u => (u.withdrawals||[]).forEach(w => wds.push({ ...w, userName: u.name, userEmail: u.email })));
    wds.sort((a,b)=>(b.ts||0)-(a.ts||0));
    $('adminWithdrawList').innerHTML = wds.length ? wds.slice(0,20).map(w => `
      <div class="tx">
        <div class="ic">🏦</div>
        <div class="info"><h5>${w.userName||'—'} • ${w.method||''}</h5><span>${w.number||''} • ${w.date||''}</span></div>
        <div class="amt out">৳${fmt(w.amount||0)}<span class="badge ${w.status==='সম্পন্ন'?'ok':''}">${w.status||'প্রসেসিং'}</span></div>
      </div>`).join('') : '<div class="empty"><span class="ic">🏦</span>কোনো উত্তোলন নেই</div>';

  } catch(e){
    console.error(e);
    toast('অ্যাডমিন ডেটা লোড ব্যর্থ', 'err');
  }
}

// অ্যাডমিন অ্যাকশন (গ্লোবাল)
window.adminCredit = async (uid, amount) => {
  const snap = await db.ref('users/' + uid).once('value');
  const u = snap.val();
  await db.ref('users/' + uid).update({
    balance: (u.balance||0) + amount,
    totalEarned: (u.totalEarned||0) + amount
  });
  await db.ref('users/' + uid + '/tx').push({
    id: uid(), type:'in', amount, title:'অ্যাডমিন ক্রেডিট', icon:'🛡️', date: now(), ts: Date.now()
  });
  toast(`৳${amount} ক্রেডিট করা হয়েছে`, 'ok');
  loadAdminData();
};
window.adminDebit = async (uid, amount) => {
  const snap = await db.ref('users/' + uid).once('value');
  const u = snap.val();
  if((u.balance||0) < amount){ toast('ব্যালেন্স কম', 'err'); return; }
  await db.ref('users/' + uid).update({ balance: (u.balance||0) - amount });
  await db.ref('users/' + uid + '/tx').push({
    id: uid(), type:'out', amount, title:'অ্যাডমিন ডেবিট', icon:'🛡️', date: now(), ts: Date.now()
  });
  toast(`৳${amount} ডেবিট করা হয়েছে`, 'ok');
  loadAdminData();
};
window.adminView = async (uid) => {
  const snap = await db.ref('users/' + uid).once('value');
  const u = snap.val();
  openModal(`
    <span class="m-ic">👤</span>
    <h3>${u.name||'—'}</h3>
    <p style="text-align:left;font-size:13px;line-height:2">
      ইমেইল: <b>${u.email||'—'}</b><br>
      ব্যালেন্স: <b style="color:var(--green)">৳${fmt(u.balance||0)}</b><br>
      মোট আয়: ৳${fmt(u.totalEarned||0)}<br>
      রেফারেল: ${u.referrals||0} জন<br>
      রেফার আয়: ৳${fmt(u.refEarned||0)}<br>
      স্ট্রিক: ${u.streak?.count||0} দিন
    </p>
    <div class="m-actions"><button class="btn" onclick="closeModal()">বন্ধ</button></div>
  `);
};

// অ্যাডমিন সার্চ
$('adminUserSearch').addEventListener('input', () => loadAdminData());

/* ---------------------------------------------------------------
   ১৪. থিম
   --------------------------------------------------------------- */
function applyTheme(){
  const t = userData?.settings?.theme || 'dark';
  document.body.dataset.theme = t;
  document.querySelector('meta[name="theme-color"]')
    .setAttribute('content', t === 'dark' ? '#0b0d17' : '#eef1fa');
}

/* ---------------------------------------------------------------
   ১৫. বুট
   --------------------------------------------------------------- */
function boot(){
  buildWheel();
  setAuthMode('signup');

  // URL রেফারেল
  const p = new URLSearchParams(location.search);
  const ref = p.get('ref');
  if(ref){ $('inpRef').value = ref.toUpperCase(); }

  setTimeout(() => {
    // Firebase auth state listener ইতিমধ্যে কাজ করছে
    // স্প্ল্যাশ থেকে অথেনটিকেশন বা মেইন স্ক্রিনে যাবে
  }, 1800);
}

document.addEventListener('DOMContentLoaded', boot);
window.closeModal = closeModal;
</script>
