<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<meta name="theme-color" content="#0b0d17">
<title>টাকাডিয়ার — ইনকাম অ্যাপ (Firebase)</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ========== ১. রিসেট ও ভেরিয়েবল ========== */
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
:root{
  --bg:#0b0d17; --bg2:#0f1222; --card:#171b31; --card2:#1e2340;
  --text:#eef1ff; --muted:#8b93b8; --border:#262c4f;
  --primary:#6c5ce7; --primary2:#a29bfe;
  --gold:#f7b731; --green:#00d68f; --red:#ff5c7a; --blue:#3aa8ff;
  --radius:16px; --shadow:0 8px 30px rgba(0,0,0,.35);
}
[data-theme="light"]{
  --bg:#eef1fa; --bg2:#e4e9f7; --card:#ffffff; --card2:#f4f7ff;
  --text:#0e1226; --muted:#6b7394; --border:#dde3f5;
  --shadow:0 8px 30px rgba(80,90,140,.15);
}
html,body{height:100%}
body{
  font-family:'Hind Siliguri',system-ui,-apple-system,sans-serif;
  background:var(--bg); color:var(--text);
  display:flex; align-items:center; justify-content:center;
  overflow:hidden; transition:background .3s,color .3s;
}

/* ========== ২. ফোন কন্টেইনার ========== */
.phone{
  position:relative; width:100%; max-width:430px; height:100dvh; max-height:920px;
  background:var(--bg); overflow:hidden; display:flex; flex-direction:column;
  box-shadow:0 0 80px rgba(108,92,231,.18);
}
@media(min-width:460px){ .phone{border-radius:26px} }

/* ========== ৩. স্ক্রিন ========== */
.screen{
  position:absolute; inset:0; display:none; flex-direction:column;
  background:var(--bg); z-index:1;
}
.screen.active{display:flex; animation:fadeUp .35s ease}
@keyframes fadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}

/* ========== ৪. স্প্ল্যাশ ========== */
#splash{
  align-items:center; justify-content:center; gap:18px;
  background:radial-gradient(circle at 50% 30%, #241d5c 0%, #0b0d17 70%);
}
[data-theme="light"] #splash{background:radial-gradient(circle at 50% 30%,#d9d3ff 0%,#eef1fa 70%)}
.splash-logo{
  width:110px;height:110px;border-radius:32px;
  background:linear-gradient(135deg,var(--primary),var(--primary2));
  display:grid;place-items:center;font-size:54px;
  box-shadow:0 20px 60px rgba(108,92,231,.55);
  animation:pop .7s cubic-bezier(.2,1.4,.5,1);
}
@keyframes pop{0%{transform:scale(.3);opacity:0}100%{transform:scale(1);opacity:1}}
.splash-title{font-size:32px;font-weight:700;letter-spacing:.5px}
.splash-sub{color:var(--muted);font-size:14px}
.loader-bar{width:150px;height:5px;border-radius:99px;background:var(--card2);overflow:hidden;margin-top:14px}
.loader-bar i{display:block;height:100%;width:0;border-radius:99px;
  background:linear-gradient(90deg,var(--primary),var(--primary2));
  animation:load 1.6s ease forwards}
@keyframes load{to{width:100%}}

/* ========== ৫. অথেনটিকেশন ========== */
#authScreen{padding:34px 24px;overflow-y:auto;justify-content:center}
.auth-head{text-align:center;margin-bottom:26px}
.auth-head .logo{
  width:78px;height:78px;border-radius:24px;margin:0 auto 16px;
  background:linear-gradient(135deg,var(--primary),var(--primary2));
  display:grid;place-items:center;font-size:38px;
  box-shadow:0 14px 40px rgba(108,92,231,.45);
}
.auth-head h1{font-size:24px;margin-bottom:6px}
.auth-head p{color:var(--muted);font-size:14px}
.field{margin-bottom:16px}
.field label{display:block;font-size:13px;color:var(--muted);margin-bottom:7px;font-weight:500}
.field input,.field select{
  width:100%;padding:14px 16px;border-radius:14px;
  background:var(--card);border:1.5px solid var(--border);
  color:var(--text);font-size:15px;font-family:inherit;outline:none;
  transition:border-color .2s,box-shadow .2s;
}
.field input:focus,.field select:focus{
  border-color:var(--primary);box-shadow:0 0 0 4px rgba(108,92,231,.16);
}
.field input::placeholder{color:var(--muted);opacity:.65}
.btn{
  width:100%;padding:15px;border:none;border-radius:14px;
  background:linear-gradient(135deg,var(--primary),var(--primary2));
  color:#fff;font-size:16px;font-weight:600;font-family:inherit;
  cursor:pointer;transition:transform .12s,opacity .2s,box-shadow .2s;
  box-shadow:0 10px 26px rgba(108,92,231,.35);
}
.btn:active{transform:scale(.975)}
.btn:disabled{opacity:.45;cursor:not-allowed;box-shadow:none}
.btn.ghost{background:var(--card);color:var(--text);box-shadow:none;border:1.5px solid var(--border)}
.btn.green{background:linear-gradient(135deg,#00b87a,#00d68f);box-shadow:0 10px 26px rgba(0,214,143,.3)}
.btn.red{background:linear-gradient(135deg,#e0455f,#ff5c7a);box-shadow:0 10px 26px rgba(255,92,122,.3)}
.btn.gold{background:linear-gradient(135deg,#e0a020,#f7b731);color:#241a00;box-shadow:0 10px 26px rgba(247,183,49,.3)}
.btn.small{padding:10px 16px;font-size:14px;width:auto;border-radius:11px}
.auth-switch{text-align:center;margin-top:20px;font-size:14px;color:var(--muted)}
.auth-switch b{color:var(--primary2);cursor:pointer}
.bonus-note{
  margin-top:22px;padding:14px;border-radius:14px;text-align:center;font-size:13px;
  background:linear-gradient(135deg,rgba(247,183,49,.14),rgba(255,92,122,.1));
  border:1px dashed rgba(247,183,49,.45);color:var(--gold);
}

/* ========== ৬. হেডার ========== */
.app-header{
  padding:16px 18px 14px;display:flex;align-items:center;justify-content:space-between;
  background:linear-gradient(160deg,var(--bg2),var(--bg));
  border-bottom:1px solid var(--border);flex-shrink:0;
}
.hdr-user{display:flex;align-items:center;gap:11px}
.avatar{
  width:42px;height:42px;border-radius:14px;flex-shrink:0;
  background:linear-gradient(135deg,var(--primary),var(--primary2));
  display:grid;place-items:center;font-size:18px;font-weight:700;color:#fff;
}
.hdr-name{font-size:15px;font-weight:600;line-height:1.25}
.hdr-sub{font-size:12px;color:var(--muted)}
.hdr-balance{
  text-align:right;padding:8px 14px;border-radius:14px;
  background:linear-gradient(135deg,rgba(0,214,143,.16),rgba(58,168,255,.1));
  border:1px solid rgba(0,214,143,.3);
}
.hdr-balance small{display:block;font-size:10px;color:var(--muted);letter-spacing:.4px}
.hdr-balance strong{font-size:17px;color:var(--green)}

/* ========== ৭. পেজ ========== */
.pages{flex:1;overflow-y:auto;overflow-x:hidden;scrollbar-width:none}
.pages::-webkit-scrollbar{display:none}
.page{display:none;padding:18px 18px 26px;animation:fadeUp .3s ease}
.page.active{display:block}
.bottom-nav{
  display:flex;flex-shrink:0;padding:9px 6px calc(9px + env(safe-area-inset-bottom));
  background:var(--card);border-top:1px solid var(--border);
}
.nav-item{
  flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;
  padding:7px 0;cursor:pointer;border:none;background:none;font-family:inherit;
  color:var(--muted);font-size:11px;font-weight:500;transition:color .2s;position:relative;
}
.nav-item .ic{font-size:20px;line-height:1;transition:transform .25s}
.nav-item.active{color:var(--primary2)}
.nav-item.active .ic{transform:translateY(-3px) scale(1.12)}
.nav-item.active::after{
  content:'';position:absolute;top:0;width:26px;height:3px;border-radius:0 0 4px 4px;
  background:var(--primary2);
}

/* ========== ৮. কার্ড ========== */
.card{
  background:var(--card);border:1px solid var(--border);border-radius:var(--radius);
  padding:16px;margin-bottom:14px;transition:transform .15s,border-color .2s;
}
.card.tappable:active{transform:scale(.985);border-color:var(--primary)}
.sec-title{font-size:16px;font-weight:600;margin:4px 0 12px;display:flex;align-items:center;gap:8px}
.sec-title span.sub{font-size:12px;color:var(--muted);font-weight:400;margin-left:auto}

.hero-card{
  position:relative;overflow:hidden;padding:24px 20px;border-radius:22px;margin-bottom:16px;
  background:linear-gradient(135deg,#6c5ce7 0%,#8b7bf0 45%,#3aa8ff 100%);
  color:#fff;box-shadow:0 18px 44px rgba(108,92,231,.4);
}
.hero-card::before,.hero-card::after{
  content:'';position:absolute;border-radius:50%;background:rgba(255,255,255,.11);
}
.hero-card::before{width:170px;height:170px;top:-70px;right:-50px}
.hero-card::after{width:110px;height:110px;bottom:-55px;left:-25px}
.hero-card .lbl{font-size:13px;opacity:.88;margin-bottom:5px;position:relative}
.hero-card .amt{font-size:36px;font-weight:700;letter-spacing:-.5px;position:relative}
.hero-card .amt small{font-size:16px;opacity:.8;font-weight:500}
.hero-row{display:flex;gap:22px;margin-top:18px;position:relative}
.hero-row div{font-size:12px;opacity:.9}
.hero-row strong{display:block;font-size:16px;margin-top:2px}

.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}

.quick{
  background:var(--card);border:1px solid var(--border);border-radius:16px;
  padding:15px 8px;text-align:center;cursor:pointer;transition:transform .15s,border-color .2s;
}
.quick:active{transform:scale(.94);border-color:var(--primary)}
.quick .ic{font-size:24px;display:block;margin-bottom:6px}
.quick .lb{font-size:11.5px;color:var(--muted);font-weight:500;line-height:1.25}

.stat{background:var(--card2);border-radius:14px;padding:13px 10px;text-align:center}
.stat .v{font-size:17px;font-weight:700;color:var(--primary2)}
.stat .k{font-size:10.5px;color:var(--muted);margin-top:2px}

.task{display:flex;align-items:center;gap:13px;padding:14px 0;border-bottom:1px solid var(--border)}
.task:last-child{border-bottom:none;padding-bottom:0}
.task:first-child{padding-top:0}
.task .ic{
  width:46px;height:46px;border-radius:14px;flex-shrink:0;display:grid;place-items:center;
  font-size:21px;background:var(--card2);
}
.task .info{flex:1;min-width:0}
.task .info h4{font-size:14.5px;font-weight:600;margin-bottom:2px}
.task .info p{font-size:12px;color:var(--muted);line-height:1.35}
.task .rw{font-size:13px;font-weight:700;color:var(--green);white-space:nowrap}
.task-btn{
  padding:8px 15px;border-radius:11px;border:none;font-family:inherit;font-size:13px;
  font-weight:600;cursor:pointer;background:var(--primary);color:#fff;white-space:nowrap;
  transition:transform .12s,opacity .2s;
}
.task-btn:active{transform:scale(.93)}
.task-btn:disabled{background:var(--card2);color:var(--muted);cursor:not-allowed}

.checkin-days{display:flex;gap:7px;margin:14px 0 4px}
.cday{
  flex:1;aspect-ratio:1/1.35;border-radius:11px;background:var(--card2);
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;
  font-size:10px;color:var(--muted);border:1.5px solid transparent;transition:.25s;
}
.cday.done{background:linear-gradient(160deg,rgba(0,214,143,.28),rgba(0,214,143,.1));
  border-color:rgba(0,214,143,.6);color:var(--green)}
.cday.today{border-color:var(--gold);box-shadow:0 0 0 3px rgba(247,183,49,.16)}
.cday b{font-size:12px}

.wheel-wrap{position:relative;width:270px;height:270px;margin:8px auto 22px}
.wheel{
  position:absolute;inset:0;border-radius:50%;
  border:8px solid var(--card2);
  box-shadow:0 0 0 4px var(--primary),0 20px 50px rgba(0,0,0,.4);
  transition:transform 4.6s cubic-bezier(.17,.67,.16,1);
}
.wheel-label{
  position:absolute;top:50%;left:50%;font-size:13px;font-weight:700;color:#fff;
  transform-origin:0 0;pointer-events:none;text-shadow:0 1px 4px rgba(0,0,0,.5);
  margin:-9px 0 0 -16px;width:32px;text-align:center;
}
.wheel-hub{
  position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
  width:66px;height:66px;border-radius:50%;z-index:3;
  background:linear-gradient(135deg,var(--primary),var(--primary2));
  display:grid;place-items:center;font-size:26px;
  box-shadow:0 6px 22px rgba(0,0,0,.5),inset 0 -3px 8px rgba(0,0,0,.2);
  border:4px solid var(--card);
}
.wheel-pointer{
  position:absolute;top:-14px;left:50%;transform:translateX(-50%);
  width:0;height:0;z-index:4;
  border-left:15px solid transparent;border-right:15px solid transparent;
  border-top:26px solid var(--gold);filter:drop-shadow(0 3px 6px rgba(0,0,0,.5));
}

.wallet-bal{
  background:linear-gradient(135deg,#00b87a,#00d68f);color:#03291c;
  border-radius:22px;padding:24px 20px;margin-bottom:16px;
  box-shadow:0 18px 44px rgba(0,214,143,.28);
}
.wallet-bal small{font-size:13px;opacity:.72;font-weight:600}
.wallet-bal .amt{font-size:38px;font-weight:700;letter-spacing:-1px;margin:4px 0 2px}
.wallet-bal .hint{font-size:12px;opacity:.72}

.methods{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:12px 0}
.method{
  padding:14px 8px;border-radius:14px;background:var(--card2);text-align:center;
  cursor:pointer;border:2px solid transparent;transition:.2s;font-size:12px;font-weight:600;
}
.method.active{border-color:var(--primary);background:rgba(108,92,231,.14)}
.method .ic{font-size:22px;display:block;margin-bottom:5px}

.tx{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid var(--border)}
.tx:last-child{border-bottom:none}
.tx .ic{
  width:40px;height:40px;border-radius:12px;flex-shrink:0;display:grid;place-items:center;
  font-size:17px;background:var(--card2);
}
.tx .info{flex:1;min-width:0}
.tx .info h5{font-size:13.5px;font-weight:600;margin-bottom:1px;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tx .info span{font-size:11px;color:var(--muted)}
.tx .amt{font-size:14px;font-weight:700;white-space:nowrap}
.tx .amt.in{color:var(--green)}
.tx .amt.out{color:var(--red)}
.badge{
  font-size:10px;padding:2px 8px;border-radius:99px;font-weight:600;
  background:rgba(247,183,49,.16);color:var(--gold);margin-left:6px;
}
.badge.ok{background:rgba(0,214,143,.16);color:var(--green)}

.prof-head{text-align:center;padding:14px 0 20px}
.prof-avatar{
  width:88px;height:88px;border-radius:28px;margin:0 auto 14px;
  background:linear-gradient(135deg,var(--primary),var(--primary2));
  display:grid;place-items:center;font-size:36px;font-weight:700;color:#fff;
  box-shadow:0 14px 36px rgba(108,92,231,.4);
}
.prof-head h2{font-size:20px;margin-bottom:3px}
.prof-head p{font-size:13px;color:var(--muted)}

.row-item{
  display:flex;align-items:center;gap:13px;padding:15px 0;
  border-bottom:1px solid var(--border);cursor:pointer;
}
.row-item:last-child{border-bottom:none;padding-bottom:0}
.row-item:first-child{padding-top:0}
.row-item .ic{font-size:19px;width:26px;text-align:center}
.row-item .tx2{flex:1;font-size:14px;font-weight:500}
.row-item .arrow{color:var(--muted);font-size:16px}
.row-item.danger .tx2{color:var(--red)}

.ref-box{
  display:flex;align-items:center;gap:10px;padding:14px 16px;border-radius:14px;
  background:linear-gradient(135deg,rgba(108,92,231,.16),rgba(58,168,255,.1));
  border:1.5px dashed rgba(108,92,231,.5);margin:12px 0;
}
.ref-box code{flex:1;font-size:17px;font-weight:700;letter-spacing:2px;color:var(--primary2)}
.ref-box button{
  padding:9px 15px;border-radius:10px;border:none;background:var(--primary);
  color:#fff;font-family:inherit;font-size:13px;font-weight:600;cursor:pointer;
}

/* ========== ৯. মোডাল ও টোস্ট ========== */
.modal-bg{
  position:absolute;inset:0;background:rgba(0,0,0,.68);backdrop-filter:blur(6px);
  display:none;align-items:center;justify-content:center;padding:24px;z-index:99;
}
.modal-bg.show{display:flex;animation:fadeIn .22s ease}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
.modal{
  width:100%;max-width:350px;background:var(--card);border-radius:22px;
  padding:24px 20px;text-align:center;border:1px solid var(--border);
  animation:modalIn .3s cubic-bezier(.2,1.3,.5,1);max-height:80vh;overflow-y:auto;
}
@keyframes modalIn{from{transform:scale(.85);opacity:0}to{transform:scale(1);opacity:1}}
.modal .m-ic{font-size:46px;margin-bottom:12px;display:block}
.modal h3{font-size:19px;margin-bottom:8px}
.modal p{font-size:14px;color:var(--muted);line-height:1.55;margin-bottom:18px}
.modal .m-actions{display:flex;gap:10px}
.modal .m-actions .btn{flex:1}

.opt{
  display:block;width:100%;text-align:left;padding:13px 16px;margin-bottom:9px;
  border-radius:12px;background:var(--card2);border:2px solid transparent;
  color:var(--text);font-family:inherit;font-size:14px;cursor:pointer;transition:.15s;
}
.opt:hover{border-color:var(--primary)}
.opt.selected{border-color:var(--primary);background:rgba(108,92,231,.16)}

.countdown{font-size:42px;font-weight:700;color:var(--primary2);margin:10px 0}
.progress{height:7px;border-radius:99px;background:var(--card2);overflow:hidden;margin:16px 0 6px}
.progress i{display:block;height:100%;width:0;border-radius:99px;
  background:linear-gradient(90deg,var(--primary),var(--primary2));transition:width .95s linear}

.toast{
  position:absolute;left:50%;bottom:96px;transform:translate(-50%,26px);
  padding:12px 22px;border-radius:14px;font-size:13.5px;font-weight:600;
  background:var(--card);border:1px solid var(--border);box-shadow:var(--shadow);
  opacity:0;pointer-events:none;transition:.3s cubic-bezier(.2,1.2,.5,1);z-index:200;
  white-space:nowrap;max-width:90%;
}
.toast.show{opacity:1;transform:translate(-50%,0)}
.toast.ok{border-color:rgba(0,214,143,.6);color:var(--green)}
.toast.err{border-color:rgba(255,92,122,.6);color:var(--red)}
.toast.gold{border-color:rgba(247,183,49,.6);color:var(--gold)}

.empty{text-align:center;padding:36px 10px;color:var(--muted);font-size:13.5px}
.empty .ic{font-size:38px;display:block;margin-bottom:10px;opacity:.5}

.confetti{position:absolute;width:9px;height:9px;border-radius:2px;pointer-events:none;z-index:150}
@keyframes fall{to{transform:translateY(105vh) rotate(720deg);opacity:0}}

/* ========== ১০. অ্যাডমিন প্যানেল ========== */
#adminScreen .app-header{background:linear-gradient(160deg,#2a1b4a,#0b0d17)}
.admin-badge{
  font-size:10px;padding:3px 9px;border-radius:99px;background:var(--gold);color:#241a00;
  font-weight:700;margin-left:8px;
}
.admin-tabs{display:flex;gap:6px;padding:12px 18px;flex-shrink:0;overflow-x:auto}
.admin-tab{
  padding:9px 16px;border-radius:11px;border:1px solid var(--border);background:var(--card);
  color:var(--muted);font-family:inherit;font-size:12.5px;font-weight:600;white-space:nowrap;
  cursor:pointer;transition:.2s;
}
.admin-tab.active{background:var(--primary);border-color:var(--primary);color:#fff}
.admin-search{
  width:100%;padding:12px 15px;border-radius:12px;background:var(--card);
  border:1.5px solid var(--border);color:var(--text);font-family:inherit;font-size:13.5px;
  outline:none;margin-bottom:12px;
}
.admin-search:focus{border-color:var(--primary)}
.admin-user-row{
  display:flex;align-items:center;gap:11px;padding:12px 0;border-bottom:1px solid var(--border);
}
.admin-user-row:last-child{border-bottom:none}
.admin-user-row .av{
  width:38px;height:38px;border-radius:12px;flex-shrink:0;
  background:linear-gradient(135deg,var(--primary),var(--primary2));
  display:grid;place-items:center;font-weight:700;color:#fff;font-size:15px;
}
.admin-user-row .info{flex:1;min-width:0}
.admin-user-row .info h5{font-size:13.5px;font-weight:600;margin-bottom:1px;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.admin-user-row .info span{font-size:11px;color:var(--muted)}
.admin-user-row .bal{font-size:13px;font-weight:700;color:var(--green);white-space:nowrap}
.admin-actions{display:flex;gap:6px;margin-top:6px}
